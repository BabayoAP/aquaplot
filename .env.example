# Copy to .env and fill in. .env is git-ignored; nothing here is read at run time
# by the app itself, which takes its configuration from the environment as usual.
# This file exists so an evaluation run can be given a key without putting it in
# shell history. See docs/EVALUATION.md.

# The key the model-layer evaluation spends. Without it the observer falls back to
# a local Ollama model, or to none at all.
ANTHROPIC_API_KEY=

# The model the evaluation and the deployed app use.
CLAUDE_MODEL=claude-opus-5

# Force a backend regardless of what is installed: claude | ollama | none.
# AQUAPLOT_OBSERVER=claude
