            "code": {
              "coding": [
                {
                  "system": "https://github.com/BabayoAP/aquaplot/fhir/CodeSystem/stream-health",
                  "code": "taxon-culicidae",
                  "display": "Culicidae (Mosquito larva (wriggler))"
                }
              ],
              "text": "Mosquito larva (wriggler): tolerant"
            },
            "valueQuantity": {
              "value": 2.0,
              "unit": "IBMWP sensitivity score"
            }
          }
        ],
        "note": [
          {
            "text": "1 sensitive family from the mayfly/stonefly/caddisfly groups (Plecoptera) were found. These animals do not persist in polluted water."
          },
          {
            "text": "Tolerant animals outnumber sensitive ones (2 to 1), the usual signature of a stream under continuous pressure rather than a one-off spill."
          },
          {
            "text": "Average sensitivity of the families present (IASPT) is 4.7 out of 10."
          },
          {
            "text": "The IBMWP total is 14. On IBMWP's own scale that is class 'Bad', but that scale assumes a standardised sample across every habitat in the reach; one tray finds far fewer families, so the total reads low. The band above is read from the IASPT instead."
          }
        ],
        "text": {
          "status": "generated",
          "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\">Benthic macroinvertebrate survey</div>"
