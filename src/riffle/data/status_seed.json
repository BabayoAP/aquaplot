    {"scientific_name": "Pistia stratiotes", "common_name": "Water Lettuce", "group": "Plantae", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Mats shade out submerged plants and create stagnant, deoxygenated water that favours mosquito larvae."},
    {"scientific_name": "Ludwigia grandiflora", "common_name": "Large-flowered Primrose-willow", "group": "Plantae", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Chokes slow urban channels, raises flood risk by blocking flow, and replaces the varied margin invertebrates depend on."},
    {"scientific_name": "Myriophyllum heterophyllum", "common_name": "Broadleaf Watermilfoil", "group": "Plantae", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Displaces native submerged vegetation and clogs slow reaches."},
    {"scientific_name": "Elodea nuttallii", "common_name": "Nuttall's Waterweed", "group": "Plantae", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Rapid growth in nutrient-rich urban water; decomposition of the die-back removes oxygen."},
    {"scientific_name": "Lagarosiphon major", "common_name": "Curly Waterweed", "group": "Plantae", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Forms dense monocultures that eliminate open water and the habitat variety invertebrates need."},
    {"scientific_name": "Hydrocotyle ranunculoides", "common_name": "Floating Pennywort", "group": "Plantae", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Can grow 20 cm a day and cover a channel completely, causing deoxygenation and flood risk."},
    {"scientific_name": "Cabomba caroliniana", "common_name": "Carolina Fanwort", "group": "Plantae", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Dense submerged growth in slow water; hard to eradicate once established."},
    {"scientific_name": "Salvinia molesta", "common_name": "Giant Salvinia", "group": "Plantae", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Floating mats thick enough to walk on; the water underneath goes anoxic."},
    {"scientific_name": "Alternanthera philoxeroides", "common_name": "Alligator Weed", "group": "Plantae", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Grows from bank into water, blocks drainage and creates standing water."},
    {"scientific_name": "Gymnocoronis spilanthoides", "common_name": "Senegal Tea Plant", "group": "Plantae", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Union-listed emergent that blocks small urban channels."},
    {"scientific_name": "Heracleum mantegazzianum", "common_name": "Giant Hogweed", "group": "Plantae", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "riparian", "why": "The clearest direct human-health hazard on the list: its sap causes severe burns and blistering in sunlight, and it colonises exactly the riverbanks where people walk."},
    {"scientific_name": "Impatiens glandulifera", "common_name": "Himalayan Balsam", "group": "Plantae", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "riparian", "why": "Dies back completely in winter, leaving bare bank that erodes into the stream and smothers the gravel beds."},
    {"scientific_name": "Reynoutria japonica", "common_name": "Japanese Knotweed", "group": "Plantae", "rating": "Widely regulated", "source": "National invasive-species legislation (not on the EU Union list)", "scope": "European Union", "habitat": "riparian", "why": "Damages bank structure and hard engineering; fragments spread downstream in flood.", "synonyms": ["Fallopia japonica", "Polygonum cuspidatum"]},
    {"scientific_name": "Procambarus virginalis", "common_name": "Marbled Crayfish", "group": "Malacostraca", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Reproduces clonally from a single individual, so one released aquarium animal can found a population; also a plague carrier."},
    {"scientific_name": "Pacifastacus leniusculus", "common_name": "Signal Crayfish", "group": "Malacostraca", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "The main vector of crayfish plague across Europe and a major bank-burrower."},
    {"scientific_name": "Faxonius limosus", "common_name": "Spiny-cheek Crayfish", "group": "Malacostraca", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Plague carrier, tolerant of polluted water, so it thrives where natives cannot.", "synonyms": ["Orconectes limosus"]},
    {"scientific_name": "Eriocheir sinensis", "common_name": "Chinese Mitten Crab", "group": "Malacostraca", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Mass migrations damage banks and fishing gear; an intermediate host of the human lung fluke in its native range."},
    {"scientific_name": "Perccottus glenii", "common_name": "Amur Sleeper", "group": "Actinopterygii", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Strips small water bodies of invertebrates and amphibian larvae; tolerates very low oxygen."},
    {"scientific_name": "Pseudorasbora parva", "common_name": "Topmouth Gudgeon", "group": "Actinopterygii", "rating": "Union list", "source": "EU Regulation 1143/2014 (Union list of invasive alien species of Union concern)", "scope": "European Union", "habitat": "freshwater", "why": "Carries a rosette parasite lethal to native fish while remaining healthy itself."},
